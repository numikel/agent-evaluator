{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"paths": {
			"@schemas/*": ["../src/schemas/*"],
			"@ui/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "../src/schemas"]
}
