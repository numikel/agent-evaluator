# agent-evaluator — environment variable NAMES only. Never commit real values.
# Recommended: keep secrets in a vault and inject them at runtime, e.g.
#   dotenvx run -- agent-evaluator serve          (encrypted .env, key outside repo)
#   op run --env-file=.env.tpl -- agent-evaluator serve   (1Password CLI, op:// references)
#   direnv + sops                                  (encrypted .envrc)
# A plain .env in the directory you start the CLI from is loaded for local experiments but
# discouraged (it is git-ignored; variables already set in the environment win).

# --- LLM providers (set only the ones you use; "provider:model" is chosen per role in settings) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Settings overrides (file < environment < CLI flags) ---
# AE_PORT=4747
# AE_RUNS_DIR=runs
# AE_HEADLESS=true
# AE_MODEL_SIMULATOR=provider:model
# AE_MODEL_JUDGE=provider:model

# --- Browser and logging ---
# AE_CHROMIUM_PATH=/path/to/chromium   # instead of `npx playwright install chromium`
# LOG_LEVEL=info

# --- Tests ---
# AE_LIVE_LLM=1   enables live-LLM smoke tests (never in CI)
